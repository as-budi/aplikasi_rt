# Salin ke backend/.env.prod di VPS dan isi semua nilai. Jangan di-commit.
DEBUG=False
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SIMPAN BAIK-BAIK & JANGAN DIGANTI: tanpa kunci ini NIK/No. KK tidak bisa dibaca lagi.
FIELD_ENCRYPTION_KEY=
ALLOWED_HOSTS=rt.domain.id
CSRF_TRUSTED_ORIGINS=https://rt.domain.id
# Password harus sama dengan MYSQL_PASSWORD di .env.db
DATABASE_URL=mysql://rt:ganti-password-kuat@db:3306/aplikasi_rt
CELERY_BROKER_URL=redis://redis:6379/0
EMAIL_URL=consolemail://

# Tampilkan iuran per rumah di buku kas untuk semua warga (False = ringkasan per bulan)
CASH_LEDGER_PUBLIC_DETAIL=True
